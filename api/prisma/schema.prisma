generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum TipoInstrumento {
  EDITAL
  EMENDA
  PARCERIA
}

enum OrigemMeta {
  EDITAL
  PROJETO
  INSTITUTO
}

enum ModalidadeAfericao {
  QUANTITATIVA
  QUALITATIVA
}

enum SituacaoMeta {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum Perfil {
  PRESIDENCIA_GESTAO
  NUCLEO_PEDAGOGICO
  ADMINISTRATIVO_FINANCEIRO
  CONCEDENTE_AUDITORIA
  ADMINISTRACAO_SISTEMA
}

enum AutorTipo {
  USUARIO
  SISTEMA
  PUBLICO
}

model Instrumento {
  id              String          @id @default(uuid()) @db.Uuid
  versao          Int             @default(1)
  tipo            TipoInstrumento
  orgaoConcedente String          @map("orgao_concedente")
  numeroProcesso  String          @map("numero_processo")
  valorGlobal     Decimal         @map("valor_global") @db.Decimal(14, 2)
  dataCelebracao  DateTime        @map("data_celebracao") @db.Date
  vigenciaInicio  DateTime        @map("vigencia_inicio") @db.Date
  vigenciaFim     DateTime        @map("vigencia_fim") @db.Date
  ativo           Boolean         @default(true)
  criadoEm        DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  projetos   Projeto[]
  requisitos RequisitoInstrumento[]
  documentos DocumentoInstrumento[]

  @@index([numeroProcesso])
  @@map("instrumento")
}

/// Documento formal do instrumento; o mais recente vale, e os anteriores ficam guardados.
model DocumentoInstrumento {
  id            String   @id @default(uuid()) @db.Uuid
  instrumentoId String   @map("instrumento_id") @db.Uuid
  chave         String   @unique
  nomeArquivo   String   @map("nome_arquivo")
  tipoConteudo  String   @map("tipo_conteudo")
  tamanho       Int
  sha256        String
  enviadoPorId  String   @map("enviado_por_id") @db.Uuid
  enviadoEm     DateTime @default(now()) @map("enviado_em") @db.Timestamptz(3)

  instrumento Instrumento @relation(fields: [instrumentoId], references: [id], onDelete: Restrict)
  enviadoPor  Usuario     @relation(fields: [enviadoPorId], references: [id], onDelete: Restrict)

  @@index([instrumentoId, enviadoEm])
  @@map("documento_instrumento")
}

model Modalidade {
  id           String   @id @default(uuid()) @db.Uuid
  versao       Int      @default(1)
  nome         String   @unique
  descricao    String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  atividades Atividade[]

  @@map("modalidade")
}

model Projeto {
  id            String   @id @default(uuid()) @db.Uuid
  versao        Int      @default(1)
  instrumentoId String   @map("instrumento_id") @db.Uuid
  coordenadorId String   @map("coordenador_id") @db.Uuid
  codigo        String
  titulo        String
  inicio        DateTime @db.Date
  fim           DateTime @db.Date
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  instrumento Instrumento @relation(fields: [instrumentoId], references: [id], onDelete: Restrict)
  coordenador Usuario     @relation(fields: [coordenadorId], references: [id], onDelete: Restrict)
  metas       Meta[]
  atividades  Atividade[]

  @@unique([instrumentoId, codigo])
  @@index([coordenadorId])
  @@map("projeto")
}

model RequisitoInstrumento {
  id            String   @id @default(uuid()) @db.Uuid
  versao        Int      @default(1)
  instrumentoId String   @map("instrumento_id") @db.Uuid
  descricao     String
  referencia    String?
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  instrumento Instrumento     @relation(fields: [instrumentoId], references: [id], onDelete: Restrict)
  metas       MetaRequisito[]

  @@index([instrumentoId])
  @@map("requisito_instrumento")
}

model Meta {
  id                 String              @id @default(uuid()) @db.Uuid
  versao             Int                 @default(1)
  projetoId          String              @map("projeto_id") @db.Uuid
  ordem              Int
  origem             OrigemMeta
  objetivo           String
  descricao          String
  indicador          String?
  modalidadeAfericao ModalidadeAfericao? @map("modalidade_afericao")
  parametroPlanejado String?             @map("parametro_planejado")
  unidade            String?
  periodoInicio      DateTime?           @map("periodo_inicio") @db.Date
  periodoFim         DateTime?           @map("periodo_fim") @db.Date
  frequenciaApuracao String?             @map("frequencia_apuracao")
  formaComprovacao   String?             @map("forma_comprovacao")
  resultadoEsperado  String?             @map("resultado_esperado")
  responsavelId      String?             @map("responsavel_id") @db.Uuid
  setorId            String?             @map("setor_id") @db.Uuid
  situacao           SituacaoMeta        @default(PENDENTE)
  criadoEm           DateTime            @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  projeto     Projeto         @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  responsavel Usuario?        @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  setor       Setor?          @relation(fields: [setorId], references: [id], onDelete: Restrict)
  requisitos  MetaRequisito[]
  atividades  AtividadeMeta[]
  resultados  ResultadoMeta[]

  @@index([projetoId])
  @@index([responsavelId])
  @@index([setorId])
  @@map("meta")
}

/// Alcance da meta no relatório de execução (RN-14).
enum AlcanceMeta {
  CUMPRIDA
  PARCIALMENTE_CUMPRIDA
  NAO_CUMPRIDA
}

/// Resultado alcançado da meta numa data de referência (RF43). Cada registro é novo;
/// o anterior fica como histórico, e o relatório usa o último até o fim do período.
model ResultadoMeta {
  id                 String      @id @default(uuid()) @db.Uuid
  metaId             String      @map("meta_id") @db.Uuid
  dataReferencia     DateTime    @map("data_referencia") @db.Date
  descricao          String
  valorAlcancado     Decimal?    @map("valor_alcancado") @db.Decimal(14, 2)
  parametroPlanejado Decimal?    @map("parametro_planejado") @db.Decimal(14, 2)
  percentual         Decimal?    @db.Decimal(8, 2)
  alcance            AlcanceMeta
  registradoPorId    String      @map("registrado_por_id") @db.Uuid
  criadoEm           DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)

  meta          Meta    @relation(fields: [metaId], references: [id], onDelete: Restrict)
  registradoPor Usuario @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)

  @@index([metaId, dataReferencia])
  @@index([registradoPorId])
  @@map("resultado_meta")
}

model MetaRequisito {
  metaId      String   @map("meta_id") @db.Uuid
  requisitoId String   @map("requisito_id") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  meta      Meta                 @relation(fields: [metaId], references: [id], onDelete: Restrict)
  requisito RequisitoInstrumento @relation(fields: [requisitoId], references: [id], onDelete: Restrict)

  @@id([metaId, requisitoId])
  @@index([requisitoId])
  @@map("meta_requisito")
}

model Atividade {
  id                  String    @id @default(uuid()) @db.Uuid
  versao              Int       @default(1)
  projetoId           String    @map("projeto_id") @db.Uuid
  modalidadeId        String    @map("modalidade_id") @db.Uuid
  responsavelId       String    @map("responsavel_id") @db.Uuid
  titulo              String
  data                DateTime  @db.Date
  /// Nulos só nas atividades cadastradas antes do horário (30/10); a tela exige os dois.
  horaInicio          DateTime? @map("hora_inicio") @db.Time(0)
  horaFim             DateTime? @map("hora_fim") @db.Time(0)
  /// Pode ser menor que o intervalo entre início e fim (pausa, almoço), nunca maior.
  cargaHorariaMinutos Int?      @map("carga_horaria_minutos")
  local               String
  criadoEm            DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm        DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  projeto     Projeto                @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  modalidade  Modalidade             @relation(fields: [modalidadeId], references: [id], onDelete: Restrict)
  responsavel Usuario                @relation(fields: [responsavelId], references: [id], onDelete: Restrict)
  metas       AtividadeMeta[]
  inscricao   ConfiguracaoInscricao?
  inscricoes  Inscricao[]

  @@index([projetoId])
  @@index([modalidadeId])
  @@index([responsavelId])
  @@map("atividade")
}

/// Campos que o formulário de inscrição pode pedir além dos mínimos (seção 8.5.4).
/// Lista fechada: dado pessoal sensível não tem como entrar (RNF05).
enum CampoInscricao {
  EMAIL
  CPF
  BAIRRO_REGIAO
  ESCOLARIDADE
}

/// Campo que identifica cadastro repetido (RF22, RF42).
enum CampoDuplicidade {
  EMAIL
  CPF
}

model ConfiguracaoInscricao {
  atividadeId      String           @id @map("atividade_id") @db.Uuid
  versao           Int              @default(1)
  aberta           Boolean          @default(true)
  vagas            Int
  camposAdicionais CampoInscricao[] @map("campos_adicionais")
  campoDuplicidade CampoDuplicidade @map("campo_duplicidade")
  /// Compromissos da turma que a pessoa aceita para se inscrever; sem termo, não há aceite.
  termoCompromisso String?          @map("termo_compromisso")
  /// Apresentação da atividade na página de inscrição (descritivo da oficina); opcional.
  apresentacao     String?
  /// Último dia para se inscrever; o formulário encerra ao fim desse dia, no horário de Brasília.
  prazoInscricao   DateTime?        @map("prazo_inscricao") @db.Date
  /// Hora opcional do prazo, para encerramento decisivo; sem ela, vale o fim do dia.
  prazoHora        DateTime?        @map("prazo_hora") @db.Time(0)
  /// WhatsApp do Instituto para dúvidas, só dígitos com DDD; nunca o número pessoal de quem coordena.
  contatoWhatsapp  String?          @map("contato_whatsapp") @db.VarChar(11)
  codigoPublico    String           @unique @map("codigo_publico")
  criadoEm         DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  atividade Atividade @relation(fields: [atividadeId], references: [id], onDelete: Restrict)

  @@map("configuracao_inscricao")
}

/// Pessoa que se inscreve numa atividade. Separada da `pessoa` da equipe do Instituto,
/// para que dados de participantes não se misturem com os de quem opera o sistema (LGPD).
/// Guarda só os campos mínimos (seção 8.5.4) e os da lista fechada da configuração (RNF05).
model Participante {
  id              String   @id @default(uuid()) @db.Uuid
  versao          Int      @default(1)
  nome            String
  /// Como a pessoa prefere ser chamada; opcional (modelo do Instituto).
  nomePreferencia String?  @map("nome_preferencia")
  telefone        String
  dataNascimento  DateTime @map("data_nascimento") @db.Date
  email           String?
  cpf             String?  @db.VarChar(11)
  bairroRegiao    String?  @map("bairro_regiao")
  escolaridade    String?
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  inscricoes Inscricao[]

  @@index([cpf])
  @@index([email])
  @@map("participante")
}

/// Canal pelo qual o titular pediu a revogação de uma autorização (CA-07a.6).
enum CanalPedido {
  EMAIL
  TELEFONE
  WHATSAPP
  PRESENCIAL
  OUTRO
}

enum SituacaoInscricao {
  CONFIRMADA
}

model Inscricao {
  id                        String            @id @default(uuid()) @db.Uuid
  atividadeId               String            @map("atividade_id") @db.Uuid
  participanteId            String            @map("participante_id") @db.Uuid
  situacao                  SituacaoInscricao @default(CONFIRMADA)
  /// Valor normalizado do campo que identifica cadastro repetido (e-mail ou CPF).
  chaveDuplicidade          String            @map("chave_duplicidade")
  versaoAviso               String            @map("versao_aviso")
  avisoApresentadoEm        DateTime          @map("aviso_apresentado_em") @db.Timestamptz(3)
  autorizaComunicados       Boolean           @map("autoriza_comunicados")
  autorizaImagem            Boolean           @map("autoriza_imagem")
  responsavelNome           String?           @map("responsavel_nome")
  responsavelTelefone       String?           @map("responsavel_telefone")
  /// Texto do termo de compromisso aceito no envio, como estava naquele momento.
  termoAceito               String?           @map("termo_aceito")
  termoAceitoEm             DateTime?         @map("termo_aceito_em") @db.Timestamptz(3)
  /// Revogação das autorizações a pedido do titular: data do pedido e canal; a autorização dada no envio fica como estava.
  comunicadosRevogadosEm    DateTime?         @map("comunicados_revogados_em") @db.Date
  comunicadosRevogacaoCanal CanalPedido?      @map("comunicados_revogacao_canal")
  imagemRevogadaEm          DateTime?         @map("imagem_revogada_em") @db.Date
  imagemRevogacaoCanal      CanalPedido?      @map("imagem_revogacao_canal")
  criadoEm                  DateTime          @default(now()) @map("criado_em") @db.Timestamptz(3)

  atividade    Atividade    @relation(fields: [atividadeId], references: [id], onDelete: Restrict)
  participante Participante @relation(fields: [participanteId], references: [id], onDelete: Restrict)

  @@unique([atividadeId, chaveDuplicidade])
  @@index([participanteId])
  @@map("inscricao")
}

model AtividadeMeta {
  atividadeId String   @map("atividade_id") @db.Uuid
  metaId      String   @map("meta_id") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  atividade Atividade @relation(fields: [atividadeId], references: [id], onDelete: Restrict)
  meta      Meta      @relation(fields: [metaId], references: [id], onDelete: Restrict)

  @@id([atividadeId, metaId])
  @@index([metaId])
  @@map("atividade_meta")
}

model Setor {
  id           String   @id @default(uuid()) @db.Uuid
  versao       Int      @default(1)
  nome         String   @unique
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  pessoas Pessoa[]
  metas   Meta[]

  @@map("setor")
}

model Pessoa {
  id           String   @id @default(uuid()) @db.Uuid
  setorId      String?  @map("setor_id") @db.Uuid
  nome         String
  cpf          String?  @unique @db.VarChar(11)
  telefone     String?
  emailContato String?  @map("email_contato")
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  setor   Setor?   @relation(fields: [setorId], references: [id], onDelete: Restrict)
  usuario Usuario?

  @@index([setorId])
  @@map("pessoa")
}

model Usuario {
  id              String    @id @default(uuid()) @db.Uuid
  pessoaId        String    @unique @map("pessoa_id") @db.Uuid
  emailLogin      String    @unique @map("email_login")
  senhaHash       String    @map("senha_hash")
  perfil          Perfil
  ativo           Boolean   @default(true)
  versao          Int       @default(1)
  deveTrocarSenha Boolean   @default(true) @map("deve_trocar_senha")
  ultimoAcessoEm  DateTime? @map("ultimo_acesso_em") @db.Timestamptz(3)
  falhasLogin     Int       @default(0) @map("falhas_login")
  bloqueadoAte    DateTime? @map("bloqueado_ate") @db.Timestamptz(3)
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  pessoa              Pessoa                 @relation(fields: [pessoaId], references: [id], onDelete: Restrict)
  projetosCoordenados Projeto[]
  atividades          Atividade[]
  metasResponsavel    Meta[]
  documentosEnviados  DocumentoInstrumento[]
  resultadosMeta      ResultadoMeta[]
  sessoes             Sessao[]
  eventos             TrilhaAuditoria[]      @relation("autor")
  previas             TrilhaAuditoria[]      @relation("previa")

  @@map("usuario")
}

model Sessao {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiraEm    DateTime  @map("expira_em") @db.Timestamptz(3)
  ultimoUsoEm DateTime  @default(now()) @map("ultimo_uso_em") @db.Timestamptz(3)
  revogadaEm  DateTime? @map("revogada_em") @db.Timestamptz(3)
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@map("sessao")
}

model TrilhaAuditoria {
  id               String    @id @default(uuid()) @db.Uuid
  autorTipo        AutorTipo @map("autor_tipo")
  usuarioId        String?   @map("usuario_id") @db.Uuid
  contextoPreviaDe String?   @map("contexto_previa_de") @db.Uuid
  acao             String
  entidade         String
  entidadeId       String?   @map("entidade_id") @db.Uuid
  antes            Json?
  depois           Json?
  correlationId    String    @map("correlation_id")
  criadoEm         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario       Usuario? @relation("autor", fields: [usuarioId], references: [id], onDelete: Restrict)
  administrador Usuario? @relation("previa", fields: [contextoPreviaDe], references: [id], onDelete: Restrict)

  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("trilha_auditoria")
}
