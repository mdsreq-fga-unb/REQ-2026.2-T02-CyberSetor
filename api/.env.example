# Valores de desenvolvimento local. Não use em homologação nem em produção.

# API
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Atrás de proxy reverso (homologação no Coolify): loopback, linklocal, uniquelocal. Vazio desliga.
TRUST_PROXY=

# Banco local pelo Compose. Se a 5432 estiver ocupada, troque POSTGRES_PORT e a porta da DATABASE_URL juntas.
POSTGRES_USER=cybersetor
POSTGRES_PASSWORD=cybersetor
POSTGRES_DB=cybersetor
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://cybersetor:cybersetor@localhost:5432/cybersetor

# Sessão
JWT_SECRET=segredo-local-de-desenvolvimento-com-mais-de-32-caracteres
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# Anexos (documento formal do instrumento)
# local: pasta, com link assinado servido pela própria API (desenvolvimento e testes).
# s3: bucket privado pela API S3 (Backblaze B2 na homologação), com link pré-assinado. Em produção, só s3.
# Os testes de ponta a ponta usam sempre local, numa pasta temporária, mesmo com s3 aqui.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# Com s3. Backblaze: S3_ENDPOINT=https://s3.<região>.backblazeb2.com e S3_REGION=<região> (ex.: us-east-005),
# como aparecem em "Endpoint" na página do bucket. Bucket privado, só dos anexos.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# Com s3: keyID e applicationKey de uma Application Key restrita ao bucket, com leitura e escrita.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Validade, em segundos, do link que abre o anexo (60 a 3600).
DOCUMENT_URL_TTL_SECONDS=300

# Primeira conta de administração (pnpm seed:admin)
SEED_ADMIN_NAME=Administração Local
SEED_ADMIN_EMAIL=admin@cybersetor.test
SEED_ADMIN_PASSWORD=senha-local-de-desenvolvimento