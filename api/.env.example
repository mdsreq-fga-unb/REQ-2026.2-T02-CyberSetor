# Valores de desenvolvimento local. Não use em homologação nem em produção.

# API
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Atrás de proxy reverso (homologação no Coolify): loopback, linklocal, uniquelocal. Vazio desliga.
TRUST_PROXY=

# Banco local pelo Compose. Se a 5432 estiver ocupada, troque POSTGRES_PORT e a porta da DATABASE_URL juntas.
POSTGRES_USER=cybersetor
POSTGRES_PASSWORD=cybersetor
POSTGRES_DB=cybersetor
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://cybersetor:cybersetor@localhost:5432/cybersetor

# Sessão
JWT_SECRET=segredo-local-de-desenvolvimento-com-mais-de-32-caracteres
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# Primeira conta de administração (pnpm seed:admin)
SEED_ADMIN_NAME=Administração Local
SEED_ADMIN_EMAIL=admin@cybersetor.test
SEED_ADMIN_PASSWORD=senha-local-de-desenvolvimento